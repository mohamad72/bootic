+  static const _reasons = {
+    'waiting': 'هنوز خروجی مدل نرسیده',
+    'accepted': 'بدن پذیرفته شد',
+    'no_pose': 'مدل بدن پیدا نکرد',
+    'invalid_landmarks': 'مختصات نامعتبر',
+    'low_confidence': 'اطمینان شانه یا لگن پایین است',
